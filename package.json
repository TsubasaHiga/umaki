{
  "name": "umaki",
  "version": "0.16.0",
  "description": "A utility that is often used in web production.",
  "author": "TsubasaHiga",
  "homepage": "https://github.com/TsubasaHiga/umaki",
  "license": "MIT",
  "keywords": [
    "utility",
    "library"
  ],
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TsubasaHiga/umaki"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs"
    },
    "./callback": {
      "types": "./dist/libs/callback/index.d.ts",
      "import": "./dist/libs/callback/index.es.js",
      "require": "./dist/libs/callback/index.cjs"
    },
    "./config": {
      "types": "./dist/libs/config/index.d.ts",
      "import": "./dist/libs/config/index.es.js",
      "require": "./dist/libs/config/index.cjs"
    },
    "./control": {
      "types": "./dist/libs/control/index.d.ts",
      "import": "./dist/libs/control/index.es.js",
      "require": "./dist/libs/control/index.cjs"
    },
    "./convert": {
      "types": "./dist/libs/convert/index.d.ts",
      "import": "./dist/libs/convert/index.es.js",
      "require": "./dist/libs/convert/index.cjs"
    },
    "./eventControl": {
      "types": "./dist/libs/eventControl/index.d.ts",
      "import": "./dist/libs/eventControl/index.es.js",
      "require": "./dist/libs/eventControl/index.cjs"
    },
    "./get": {
      "types": "./dist/libs/get/index.d.ts",
      "import": "./dist/libs/get/index.es.js",
      "require": "./dist/libs/get/index.cjs"
    },
    "./is": {
      "types": "./dist/libs/is/index.d.ts",
      "import": "./dist/libs/is/index.es.js",
      "require": "./dist/libs/is/index.cjs"
    },
    "./remove": {
      "types": "./dist/libs/remove/index.d.ts",
      "import": "./dist/libs/remove/index.es.js",
      "require": "./dist/libs/remove/index.cjs"
    },
    "./security": {
      "types": "./dist/libs/security/index.d.ts",
      "import": "./dist/libs/security/index.es.js",
      "require": "./dist/libs/security/index.cjs"
    },
    "./set": {
      "types": "./dist/libs/set/index.d.ts",
      "import": "./dist/libs/set/index.es.js",
      "require": "./dist/libs/set/index.cjs"
    },
    "./to": {
      "types": "./dist/libs/to/index.d.ts",
      "import": "./dist/libs/to/index.es.js",
      "require": "./dist/libs/to/index.cjs"
    },
    "./transform": {
      "types": "./dist/libs/transform/index.d.ts",
      "import": "./dist/libs/transform/index.es.js",
      "require": "./dist/libs/transform/index.cjs"
    },
    "./wait": {
      "types": "./dist/libs/wait/index.d.ts",
      "import": "./dist/libs/wait/index.es.js",
      "require": "./dist/libs/wait/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "analyze": "tsc && vite build --mode analyze",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "isomorphic-dompurify": "^4.6.0",
    "md5": "^2.3.0",
    "query-string": "^10.0.0",
    "store2": "^2.14.4",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.19.2",
    "@types/ua-parser-js": "^0.7.39",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
